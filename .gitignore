# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test evidence screenshots (kept local, not committed)
/docs/screenshots/

# local test scripts and fixtures (kept local, not committed)
/tests/

# playwright e2e (sessions, traces, reports)
/e2e/.auth/
/e2e/.results/
/e2e/.report/
/e2e/.demo-results/
/e2e/.demo-report/
/e2e/.demo-runtime/
/e2e/.production-runtime/
/e2e/.production-results/
/e2e/.production-report/
/e2e/.system-results/
/e2e/.system-report/
