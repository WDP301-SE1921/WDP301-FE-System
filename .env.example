# Backend NestJS origin with /api/v1. Server-only: tokens stay in HttpOnly cookies.
# The web runs on port 3001 (`npm run dev` / `npm run start`); the backend keeps 3000.
# The web refuses to call itself if this points at its own port.
BACKEND_API_URL=http://localhost:3000/api/v1
# Optional: origin the browser uses for the notification socket (Socket.IO on /socket.io).
# Defaults to the origin of BACKEND_API_URL. The web origin must be in the backend CORS_ORIGINS.
# REALTIME_PUBLIC_URL=http://localhost:3000
