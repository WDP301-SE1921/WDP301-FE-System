# Copy to e2e/production/.env or run npm run test:e2e:production:setup.
# Share the real .env privately with teammates. It is excluded from Git/Docker.
E2E_PRODUCTION_WEB_URL=https://edugrade.45.77.168.110.sslip.io
E2E_PRODUCTION_API_URL=https://api.edugrade.45.77.168.110.sslip.io/api/v1
E2E_PRODUCTION_ADMIN_URL=https://admin.edugrade.45.77.168.110.sslip.io

# Required for authenticated routes and business flows.
E2E_PRODUCTION_PASSWORD=
E2E_MANAGER_EMAIL=manager@edugrade.local
E2E_STAFF_EMAIL=staff@edugrade.local
E2E_TEACHER_EMAIL=teacher@edugrade.local
E2E_DESIGNER_EMAIL=designer@edugrade.local
E2E_ADMIN_EMAIL=admin@edugrade.local
E2E_PARENT_EMAIL=

# Optional: override the shared password for an individual role.
# E2E_MANAGER_PASSWORD=
# E2E_STAFF_PASSWORD=
# E2E_TEACHER_PASSWORD=
# E2E_DESIGNER_PASSWORD=
# E2E_ADMIN_PASSWORD=
# E2E_PARENT_PASSWORD=

# Required only for direct real-provider probes (--providers / --services).
# Application-side AI/outbox checks use the production server's configuration.
AI_CHAT_URL=https://api.deepseek.com/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_VISION_CHAT_URL=https://api.deepseek.com/chat/completions
AI_VISION_API_KEY=
AI_VISION_MODEL=deepseek-flash
SMTP_URL=
MAIL_FROM=

# Default: Playwright's portable Chromium. Optional installed browser:
# E2E_CHANNEL=msedge

# After a CLI run: publish online via the current Git login, print its URL and exit.
# Publishing requires write permission to this repository; no GitHub key is committed.
E2E_REPORT_PUBLISH=1
